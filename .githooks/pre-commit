#!/bin/bash
# Auto-bump the patch version of every plugin with staged changes

for plugin_json in plugins/*/.claude-plugin/plugin.json; do
  plugin_dir=$(dirname "$(dirname "$plugin_json")")
  git diff --cached --quiet -- "$plugin_dir" && continue

  jq '.version |= (split(".") | .[2] |= (tonumber + 1 | tostring) | join("."))' \
    "$plugin_json" > "$plugin_json.tmp" && mv "$plugin_json.tmp" "$plugin_json"

  git add "$plugin_json"
done
